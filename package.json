{
  "name": "reusable-ts-input-system",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun --bun vite",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun --bun vite build && tsc -p tsconfig.build.json",
    "build:demo": "bun run typecheck && bun --bun vite build --mode demo",
    "preview": "bun --bun vite preview --mode demo",
    "test": "bun test"
  },
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
